# HTTPS origin on your Node hosting provider. HTTPS is required for remote cameras.
PORT=3000
# A production TURN service is required for reliable connections across networks.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Vercel website: URL of the separately deployed persistent signaling server.
# Leave empty when running the combined custom server locally.
SIGNALING_SERVER_URL=
# Signaling service: exact website origins, comma-separated (no trailing slash).
ALLOWED_ORIGINS=https://test-xyom.vercel.app

# Recommended Vercel + Neon setup (server-only; never use NEXT_PUBLIC_DATABASE_URL).
DATABASE_URL=
